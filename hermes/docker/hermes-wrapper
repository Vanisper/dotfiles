#!/bin/bash
# Hermes Agent通用Wrapper
#
# 用法：
#   hermes-wrapper chat           - 交互式聊天（CLI）
#   hermes-wrapper setup          - 配置向导
#   hermes-wrapper gateway        - 启动网关（后台）
#   hermes-wrapper dashboard      - 启动Dashboard
#   hermes-wrapper acp            - ACP模式（编辑器集成）
#   hermes-wrapper logs           - 查看日志
#   hermes-wrapper stop           - 停止网关
#   hermes-wrapper config         - 查看配置文件路径
#
# 环境变量：
#   HERMES_IMAGE                  - Docker镜像名（默认：nousresearch/hermes-agent）
#   HERMES_DATA                   - 数据目录（默认：~/.hermes）
#   HERMES_PORT                   - Gateway端口（默认：18642）
#   HERMES_DASHBOARD_PORT         - Dashboard端口（默认：19119）
#   HERMES_UID / HERMES_GID       - 用户权限映射
#   HERMES_DASHBOARD              - 启用dashboard（1或true）

set -e

# ============================================================
# 路径配置管理
# ============================================================

# 配置文件：与 wrapper 同目录
WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
PATHS_FILE="$WRAPPER_DIR/.hermes-wrapper.paths"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

# 从配置文件中提取所有 mount 路径（去重）
# 输出: 每行一条路径
paths_get_mounts() {
    if [ -f "$PATHS_FILE" ]; then
        awk '
            /^(mount|skip):/ {
                i = index($0, ":")
                s = substr($0, 1, i-1)
                r = substr($0, i+1)
                if (s == "mount" && !seen[r]++) print r
            }
        ' "$PATHS_FILE"
    fi
}

# 读取配置文件中指定路径的状态
# 输出: mount / skip / 空(不存在)
paths_get_status() {
    local target_path="$1"
    if [ -f "$PATHS_FILE" ]; then
        awk -v p="$target_path" '
            /^(mount|skip):/ {
                i = index($0, ":")
                s = substr($0, 1, i-1)
                r = substr($0, i+1)
                if (r == p) { print s; exit }
            }
        ' "$PATHS_FILE"
    fi
}

# 查找覆盖指定路径的父路径（已设为mount的）
# 输出: 最近的mount父路径，或空
paths_find_covering_parent() {
    local target_path="$1"
    if [ ! -f "$PATHS_FILE" ]; then
        return
    fi
    local mount_paths
    mount_paths=$(paths_get_mounts)
    local best=""
    while IFS= read -r mp; do
        [ -z "$mp" ] && continue
        # 父路径条件：target_path 以 mp/ 开头，且 mp != target_path
        if [ "$target_path" != "$mp" ] && [ "${target_path#$mp/}" != "$target_path" ]; then
            if [ -z "$best" ] || [ ${#mp} -gt ${#best} ]; then
                best="$mp"
            fi
        fi
    done <<< "$mount_paths"
    echo "$best"
}

# 写入或更新路径配置
# 用法: paths_upsert <status> <path>
# 行为: 删除旧记录，将新记录置顶，重写文件
paths_upsert() {
    local status="$1"
    local target_path="$2"

    # 收集去重后的剩余数据行
    local remaining=""
    if [ -f "$PATHS_FILE" ]; then
        remaining=$(awk -v p="$target_path" '
            /^(mount|skip):/ {
                i = index($0, ":")
                s = substr($0, 1, i-1)
                r = substr($0, i+1)
                if (r == p) next
                print
            }
        ' "$PATHS_FILE")
    fi

    # 重写文件：注释头 + 新记录 + 剩余数据
    {
        echo "# hermes-wrapper 路径配置"
        echo "# 格式: 状态:绝对路径"
        echo "# 状态: mount(持久化挂载) / skip(跳过持久化)"
        echo ""
        echo "${status}:${target_path}"
        if [ -n "$remaining" ]; then
            echo "$remaining"
        fi
    } > "$PATHS_FILE"
}

# 前缀剪枝（Prefix Pruning）
# 参数: $1 = 可选的额外路径（如 CWD），与配置文件中的 mount 路径一起参与剪枝
# 输出: 去重后的最小挂载路径集合（每行一条）
paths_prefix_prune() {
    local extra_path="${1:-}"
    local -a all_paths=()

    # 收集配置中的 mount 路径
    while IFS= read -r mp; do
        [ -z "$mp" ] && continue
        all_paths+=("$mp")
    done <<< "$(paths_get_mounts)"

    # 加入额外路径（如 CWD），与配置路径统一剪枝
    if [ -n "$extra_path" ]; then
        all_paths+=("$extra_path")
    fi

    # 按路径长度升序排列（短路径优先，父目录优先）
    local sorted_str
    sorted_str=$(for p in "${all_paths[@]}"; do echo "${#p} $p"; done | sort -n | cut -d' ' -f2-)

    local -a kept=()
    while IFS= read -r mp; do
        [ -z "$mp" ] && continue
        local covered=false
        for kp in "${kept[@]}"; do
            # 精确相等，或 mp 是 kp 的子路径
            if [ "$mp" = "$kp" ] || [ "${mp#$kp/}" != "$mp" ]; then
                covered=true
                break
            fi
        done
        if [ "$covered" = false ]; then
            kept+=("$mp")
        fi
    done <<< "$sorted_str"

    for kp in "${kept[@]}"; do
        echo "$kp"
    done
}

# 交互式处理当前工作目录
# 1. 新路径 → 问询是否挂载
# 2. 旧路径 mount → 静默提示
# 3. 旧路径 skip → 问询是否改为挂载
handle_workspace_path() {
    local cwd="$1"
    local status covering default_ans ans

    status=$(paths_get_status "$cwd")

    if [ -z "$status" ]; then
        # 新路径
        covering=$(paths_find_covering_parent "$cwd")
        echo -e "${CYAN}🆕 新路径:${RESET} $cwd"
        if [ -n "$covering" ]; then
            echo -e "${DIM}   已被挂载路径 $covering 覆盖，本次仍可访问${RESET}"
            echo -e "${YELLOW}   是否设为持久化挂载? [y/N]${RESET}"
            default_ans="N"
        else
            echo -e "${YELLOW}   是否设为持久化挂载? [Y/n]${RESET}"
            default_ans="Y"
        fi
        read -r ans </dev/tty
        ans="${ans:-$default_ans}"
        if [[ "$ans" =~ ^[Yy] ]]; then
            paths_upsert "mount" "$cwd"
            echo -e "${GREEN}   ✓ 已持久化挂载${RESET}"
        else
            paths_upsert "skip" "$cwd"
            echo -e "${DIM}   ○ 本次临时挂载（未持久化）${RESET}"
        fi
    elif [ "$status" = "mount" ]; then
        # 旧路径，已持久化挂载
        paths_upsert "mount" "$cwd"  # 刷新到顶部
        echo -e "${GREEN}📂 $cwd → 已持久化挂载${RESET}"
    else
        # 旧路径，skip
        covering=$(paths_find_covering_parent "$cwd")
        if [ -n "$covering" ]; then
            echo -e "${DIM}📂 $cwd → 未持久化（已被 $covering 覆盖，本次仍可访问）${RESET}"
        else
            echo -e "${YELLOW}📂 $cwd → 未持久化（本次临时挂载）${RESET}"
        fi
        echo -e "${YELLOW}   是否设为持久化挂载? [y/N]${RESET}"
        read -r ans </dev/tty
        if [[ "$ans" =~ ^[Yy] ]]; then
            paths_upsert "mount" "$cwd"
            echo -e "${GREEN}   ✓ 已持久化挂载${RESET}"
        else
            paths_upsert "skip" "$cwd"
        fi
    fi
}

# 生成 Docker -v 挂载参数
# 参数: $1 = CWD（当前工作目录）
# 输出: bash 数组元素，每个元素为 "-v" 或 "host:container"
# 逻辑: CWD 与配置路径统一前缀剪枝，避免父子重复挂载
generate_volume_args() {
    local cwd="$1"
    local -a vol_args=()
    local pruned
    pruned=$(paths_prefix_prune "$cwd")

    while IFS= read -r mp; do
        [ -z "$mp" ] && continue
        vol_args+=("-v" "${mp}:/workspace${mp}")
    done <<< "$pruned"

    printf '%s\n' "${vol_args[@]}"
}

# 生成容器内工作目录（-w 参数）
# 参数: $1 = CWD, $2 = 是否交互模式 (true/false)
# 交互模式 → 指向具体项目目录
# 非交互模式 → 指向 /workspace（俯瞰所有挂载）
generate_workdir() {
    local cwd="$1"
    local interactive="${2:-true}"
    if [ "$interactive" = true ] && [ -n "$cwd" ]; then
        echo "/workspace${cwd}"
    else
        echo "/workspace"
    fi
}

# 需要工作目录挂载的命令
NEEDS_WORKSPACE="chat acp gateway"

# ============================================================
# 主流程
# ============================================================

# 默认配置
HERMES_IMAGE="${HERMES_IMAGE:-nousresearch/hermes-agent}"
HERMES_DATA="${HERMES_DATA:-$HOME/.hermes}"
HERMES_UID="${HERMES_UID:-$(id -u)}"
HERMES_GID="${HERMES_GID:-$(id -g)}"
HERMES_PORT="${HERMES_PORT:-18642}"
HERMES_DASHBOARD_PORT="${HERMES_DASHBOARD_PORT:-19119}"

# 获取命令
COMMAND="${1:-}"
shift || true

# 通用Docker运行选项
DOCKER_OPTS=(
    --rm
    -e "HERMES_UID=$HERMES_UID"
    -e "HERMES_GID=$HERMES_GID"
    -v "$HERMES_DATA:/opt/data"
)

# Gateway专用选项（不使用--rm）
GATEWAY_OPTS=(
    -d
    --restart unless-stopped
    -e "HERMES_UID=$HERMES_UID"
    -e "HERMES_GID=$HERMES_GID"
    -v "$HERMES_DATA:/opt/data"
    -p "${HERMES_PORT}:8642"
)

# 工作目录（用于需要挂载项目目录的命令）
WORKSPACE="${HERMES_PROJECT_PATH:-$(pwd -P)}"

# 判断是否交互式（是否启用持久化问询和挂载）
# HERMES_INTERACTIVE:
#   不设置 / 1/true → 交互（问询持久化，挂载CWD）
#   0/false         → 静默（不问询，挂载CWD）
#   -1              → 静默（不问询，不挂载CWD，仅挂载配置中的持久化路径）
# 无 TTY 时自动降级为静默
IS_INTERACTIVE=true
SKIP_CWD_MOUNT=false
if [ -n "${HERMES_INTERACTIVE:-}" ]; then
    case "$HERMES_INTERACTIVE" in
        0|false|False|FALSE) IS_INTERACTIVE=false ;;
        -1) IS_INTERACTIVE=false; SKIP_CWD_MOUNT=true ;;
    esac
elif [ ! -t 0 ] || [ ! -t 1 ]; then
    # 没有 TTY，自动静默
    IS_INTERACTIVE=false
fi

# 对需要工作目录的命令，处理路径配置并生成挂载参数
if echo "$NEEDS_WORKSPACE" | grep -qw "$COMMAND"; then
    local mount_src="$WORKSPACE"
    if [ "$IS_INTERACTIVE" = true ]; then
        # 交互模式：走完整问询流程
        handle_workspace_path "$WORKSPACE"
        echo ""
    elif [ "$SKIP_CWD_MOUNT" = true ]; then
        # -1 模式：不挂载 CWD，仅挂载配置中的持久化路径
        mount_src=""
        echo -e "${DIM}📂 跳过当前目录挂载（-1 模式）${RESET}"
    else
        # 非交互模式：静默，CWD 参与剪枝但不问询不写配置
        echo -e "${DIM}📂 $WORKSPACE → 临时挂载（非交互模式）${RESET}"
    fi

    VOLUME_ARGS=()
    while IFS= read -r line; do
        VOLUME_ARGS+=("$line")
    done <<< "$(generate_volume_args "$mount_src")"
    CONTAINER_WORKDIR=$(generate_workdir "$WORKSPACE" "$IS_INTERACTIVE")
fi

case "$COMMAND" in
    chat)
        # 交互式聊天（直接运行镜像，不需要chat参数）
        docker run -it "${DOCKER_OPTS[@]}" \
            "${VOLUME_ARGS[@]}" \
            -w "$CONTAINER_WORKDIR" \
            "$HERMES_IMAGE"
        ;;
    setup)
        # 配置向导
        docker run -it "${DOCKER_OPTS[@]}" \
            "$HERMES_IMAGE" setup "$@"
        ;;
    gateway)
        # 启动网关（后台运行）
        if docker ps --format '{{.Names}}' | grep -q '^hermes$'; then
            echo "Hermes网关已在运行"
            docker ps | grep hermes
        else
            # 如果容器已存在但未运行，先删除
            docker ps -a --format '{{.Names}}' | grep -q '^hermes$' && docker rm -f hermes >/dev/null 2>&1 || true

            echo "启动Hermes网关..."
            docker run "${GATEWAY_OPTS[@]}" \
                --name hermes \
                -e "HERMES_DASHBOARD=${HERMES_DASHBOARD:-}" \
                -p "${HERMES_DASHBOARD_PORT}:9119" \
                "${VOLUME_ARGS[@]}" \
                -w "$CONTAINER_WORKDIR" \
                "$HERMES_IMAGE" gateway run
            echo "网关已启动，使用 'hermes-wrapper logs' 查看日志"
        fi
        ;;
    dashboard)
        # 启用dashboard并重启网关
        # 递归调用自身，设置环境变量后执行 gateway 命令
        HERMES_DASHBOARD=1 "$0" gateway
        echo ""
        echo "Dashboard: http://localhost:${HERMES_DASHBOARD_PORT}"
        echo "Gateway API: http://localhost:${HERMES_PORT}"
        ;;
    acp)
        # ACP模式（编辑器集成）
        if [ ! -d "$WORKSPACE" ]; then
            >&2 echo "错误：项目目录不存在：$WORKSPACE"
            exit 1
        fi
        docker run -i --rm \
            -e "HERMES_UID=$HERMES_UID" \
            -e "HERMES_GID=$HERMES_GID" \
            -v "$HERMES_DATA:/opt/data" \
            "${VOLUME_ARGS[@]}" \
            -w "$CONTAINER_WORKDIR" \
            "$HERMES_IMAGE" acp
        ;;
    logs)
        # 查看日志
        if docker ps --format '{{.Names}}' | grep -q '^hermes$'; then
            docker logs -f hermes
        else
            >&2 echo "Hermes网关未运行"
            exit 1
        fi
        ;;
    stop)
        # 停止网关
        if docker ps --format '{{.Names}}' | grep -q '^hermes$'; then
            docker stop hermes
            docker rm hermes
            echo "Hermes网关已停止"
        else
            echo "Hermes网关未运行"
        fi
        ;;
    config)
        # 显示配置文件路径及内容摘要
        echo -e "${BOLD}配置文件路径:${RESET}"
        echo -e "  $PATHS_FILE"
        echo ""
        if [ -f "$PATHS_FILE" ]; then
            echo -e "${BOLD}文件内容:${RESET}"
            cat "$PATHS_FILE"
        else
            echo -e "${DIM}（文件不存在，首次运行 chat/acp/gateway 时自动创建）${RESET}"
        fi
        echo ""
        echo -e "${DIM}手动编辑: ${CYAN}${EDITOR:-vi} $PATHS_FILE${RESET}"
        ;;
    *)
        >&2 echo "用法: hermes-wrapper {chat|setup|gateway|dashboard|acp|logs|stop|config}"
        >&2 echo ""
        >&2 echo "命令:"
        >&2 echo "  chat           交互式聊天（CLI）"
        >&2 echo "  setup          配置向导"
        >&2 echo "  gateway        启动网关（后台）"
        >&2 echo "  dashboard      启用Dashboard"
        >&2 echo "  acp            ACP模式（编辑器集成）"
        >&2 echo "  logs           查看日志"
        >&2 echo "  stop           停止网关"
        >&2 echo "  config         查看配置文件路径"
        >&2 echo ""
        >&2 echo "环境变量:"
        >&2 echo "  HERMES_IMAGE          Docker镜像名（默认：nousresearch/hermes-agent）"
        >&2 echo "  HERMES_DATA           数据目录（默认：~/.hermes）"
        >&2 echo "  HERMES_PORT           Gateway端口（默认：18642）"
        >&2 echo "  HERMES_DASHBOARD_PORT Dashboard端口（默认：19119）"
        >&2 echo "  HERMES_PROJECT_PATH   工作目录（默认：当前目录）"
        >&2 echo "  HERMES_DASHBOARD=1    启用dashboard"
        >&2 echo "  HERMES_INTERACTIVE=0  静默模式（不问询，挂载CWD）"
        >&2 echo "  HERMES_INTERACTIVE=-1 静默模式（不问询，不挂载CWD）"
        exit 1
        ;;
esac
